# OpenRouter API Key
# Get from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# OpenAI API Key (optional, if not using OAuth)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Telegram Bot Token
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Voice channel HTTP server port (REST chat + SSE reminders for the browser dashboard)
VOICE_PORT=7891

# voice-service URL (internal STT/TTS service, pm2 process "voice-service")
VOICE_SERVICE_URL=http://localhost:8090
